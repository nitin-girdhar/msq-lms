# ─────────────────────────────────────────────────────────────────────────────
# LMS product (msq-lms) — leads-service, meta-conversion-api,
# notifications-service, lms-web.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL connection (shared cluster — see msq-core) ──────────────────
DB_NAME=crm
DB_PORT=5432
# Hostname of msq-core's Postgres container (see its cross-repo networking note).
DB_CONTAINER_NAME=msq-db-server

# Per-product DB login role (P1.2/D8, created by db_scripts/19 — currently
# shipped whole in msq-core, see its README). Reads/writes only
# lms/marketing/ext + read-only iam/entity/geo.
DB_LMS_SVC_USER=lms_svc
DB_LMS_SVC_PASSWORD=LmsSvc_Dev2025
DB_SERVICE_USER=root_service
DB_SERVICE_PASSWORD=CrmSvc_Dev2025

DATABASE_URL=postgres://lms_svc:LmsSvc_Dev2025@localhost:5432/crm
DATABASE_URL_SERVICE=postgres://root_service:CrmSvc_Dev2025@localhost:5432/crm
# Tells @platform/db's withRoleTx to skip `SET LOCAL ROLE app_user` — required
# for the per-product login, see db_scripts/19_init-per-product-db-grants.sql.
DB_PRODUCT_SCOPED_LOGIN=true

PG_MAX=10
PG_IDLE_TIMEOUT=30
PG_SSL_MODE=disable

# ── Auth (must match msq-core's identity-service exactly) ─────────────────
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
# JWT_PUBLIC_KEY=    # RS256 verification — preferred over JWT_SECRET, see msq-core
INTERNAL_SERVICE_SECRET=change-me-to-another-long-random-string

# API key for the intake webhook endpoint (pre-shared with ad platform integrations)
WEBHOOK_API_KEY=change-me-webhook-key

# Meta credential encryption (app_secret + page access_token stored at rest).
# 32-byte key as 64 hex chars or base64. REQUIRED in production; if unset in dev,
# Meta credentials are stored in plaintext. Generate: openssl rand -hex 32
META_ENCRYPTION_KEY=change-me-64-hex-chars-0000000000000000000000000000000000000000

# Allow unsigned Meta webhooks (skips HMAC when no signature header is present).
# Must be false/unset in production; only for local testing without a real app secret.
ALLOW_UNSIGNED_WEBHOOKS=true

# ── Follow-up due/overdue push notifications (notifications-service) ─────────
# NOTIFICATION path only. None of these affect the follow-ups grid or pipeline,
# which leads-service serves from its own queries.
FOLLOWUP_CHECK_INTERVAL_MS=60000
# How far AHEAD to warn before a follow-up falls due.
FOLLOWUP_LOOKAHEAD_MINUTES=5
# How far BACK an overdue follow-up is still worth pushing a notification for
# (default 1440 = 24h). This bound is what keeps the poller's working set from
# being "every lead ever scheduled and never completed" — a set that only grows
# and was previously re-scanned on every tick. Older items remain visible in the
# follow-ups grid; they just stop generating repeat push notifications.
FOLLOWUP_LOOKBACK_MINUTES=1440
# Hard cap on rows processed per tick (default 500). A backlog past this is
# deferred to the next tick, most-overdue first, and logs a warning.
FOLLOWUP_MAX_ROWS_PER_TICK=500
# IANA zone the daily dedupe reset is computed in (default Asia/Kolkata). Was
# effectively UTC, which reset at 05:30 IST — mid working morning — and
# re-notified everything already dismissed that day.
FOLLOWUP_RESET_TIMEZONE=Asia/Kolkata

# ─────────────────────────────────────────────────────────────────────────────
# Service ports
# ─────────────────────────────────────────────────────────────────────────────
LEADS_SERVICE_PORT=4002
META_SERVICE_PORT=4003
NOTIFICATIONS_SERVICE_PORT=4004
# msq-core's communication-service. Owned by that repo, but named here because
# leads-service relays "send WhatsApp to lead" through it — must match
# msq-core's COMMUNICATION_SERVICE_PORT.
COMMUNICATION_SERVICE_PORT=4005

# ── Internal service URLs (this repo's services + the shared gateway) ───────
# Port msq-core's api-gateway listens on — docker-compose composes the gateway
# URL from it, so it must match msq-core's GATEWAY_PORT.
GATEWAY_PORT=4000
API_GATEWAY_INTERNAL_URL=http://localhost:4000
LEADS_SERVICE_URL=http://localhost:4002
META_SERVICE_URL=http://localhost:4003
NOTIFICATIONS_SERVICE_URL=http://localhost:4004
COMMUNICATION_SERVICE_URL=http://localhost:4005

NODE_ENV=development

# ─────────────────────────────────────────────────────────────────────────────
# lms-web (Next.js) → lms.app.com
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_LMS_URL=http://localhost:3001
NEXT_PUBLIC_HR_URL=http://localhost:3002
NEXT_PUBLIC_TASK_URL=http://localhost:3003
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=12
COOKIE_SECURE=false

# Outbound request timeout (ms) - leads-service.
# communication-service. MUST exceed INTERAKT_TIMEOUT_MS, or this side gives up
# while the send is still in flight and reports failure for a delivered message.
LEADS_COMMUNICATION_SERVICE_TIMEOUT_MS=15000

# Outbound request timeout (ms) - meta-conversion-api.
# leads-service intake. Short: runs inside Meta's webhook delivery window, and a
# slow ack makes Meta retry the same delivery.
META_LEADS_SERVICE_TIMEOUT_MS=10000

# RS256 migration switch. While HS256 is accepted, RS256 buys nothing security-wise:
# JWT_SECRET mints equally valid tokens and must exist wherever tokens are verified.
# Cutover: (1) set JWT_PRIVATE_KEY + JWT_KID on identity-service and JWT_PUBLIC_KEY
# everywhere; (2) wait one full token lifetime; (3) set this to false EVERYWHERE;
# (4) delete JWT_SECRET from everything that does not sign.
# Only the exact string 'false' disables HS256. Setting false without an RSA key makes
# identity-service refuse to boot - deliberately, since it would otherwise sign tokens
# that nothing, including itself, could verify.
JWT_ALLOW_HS256=true
