# notifications-service — required environment variables
DATABASE_URL=postgres://lead_svc:LeadSvc_Dev2025@localhost:5432/crm
DATABASE_URL_SERVICE=postgres://root_service:CrmSvc_Dev2025@localhost:5432/crm
INTERNAL_SERVICE_SECRET=change-me-to-another-long-random-string
NOTIFICATIONS_SERVICE_PORT=4004
FOLLOWUP_CHECK_INTERVAL_MS=60000
FOLLOWUP_LOOKAHEAD_MINUTES=5
NODE_ENV=development

# Follow-up push notifications (notifications-service). NOTIFICATION path only -
# none of these affect the follow-ups grid, which leads-service serves separately.
# How far BACK an overdue follow-up still warrants a push (24h). This bound is
# what stops the poller's working set being 'every lead ever scheduled and never
# completed' - a set that only grows and was re-scanned on every tick.
FOLLOWUP_LOOKBACK_MINUTES=1440
# Hard cap per tick; overflow defers to the next tick, most-overdue first.
FOLLOWUP_MAX_ROWS_PER_TICK=500
# Zone the daily dedupe reset uses. Was effectively UTC = 05:30 IST, mid working
# morning, re-notifying everything already dismissed that day.
FOLLOWUP_RESET_TIMEZONE=Asia/Kolkata
