{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": [
    "src/routes",
    "src/mutations",
    "src/queries",
    "src/serializers",
    // Tests are excluded from the BUILD so they stay out of dist. They are still
    // typechecked — see tsconfig.typecheck.json, which the `typecheck` script
    // uses. Excluding them from both would leave the test suite as the only
    // unchecked code in the service.
    "src/**/*.test.ts",
    "src/**/__tests__/**"
  ]
}
