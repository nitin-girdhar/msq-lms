# leads-service — required environment variables
# lms_svc can read/write only lms/marketing/ext + read-only iam/entity/geo (D8).
DATABASE_URL=postgres://lms_svc:LmsSvc_Dev2025@localhost:5432/crm
DATABASE_URL_SERVICE=postgres://root_service:CrmSvc_Dev2025@localhost:5432/crm
# Tenant-dashboard pool: withRoleTx routes tenant_admin requests here. Without it
# every tenant_admin request throws at first use (Issue #1).
DATABASE_URL_TENANT=postgres://tenant_dash_svc:TenantSvc_Dev2025@localhost:5432/crm
# Tells @platform/db to skip SET ROLE app_user, which would undo that isolation.
DB_PRODUCT_SCOPED_LOGIN=true
INTERNAL_SERVICE_SECRET=change-me-to-another-long-random-string
LEADS_SERVICE_PORT=4002
META_SERVICE_URL=http://localhost:4003
# Used by the "send WhatsApp to lead" route, which relays through
# communication-service's /communications/public-send (X-Internal-Secret).
COMMUNICATION_SERVICE_URL=http://localhost:4005
NODE_ENV=development

# Outbound request timeout (ms) - leads-service.
# communication-service. MUST exceed INTERAKT_TIMEOUT_MS, or this side gives up
# while the send is still in flight and reports failure for a delivered message.
LEADS_COMMUNICATION_SERVICE_TIMEOUT_MS=15000

# Daily lead report job. Optional — the job works with this unset.
# Bcc platform super_admins on every tenant's report. Set to false to send only
# to each tenant's own tenant_admins.
# NOTE: the job runs INSIDE the leads-service container, so in the compose
# deployment this belongs in msq-deploy/artifacts/.env, not here.
# Only the exact lowercase 'false' disables it — FALSE / 0 / no all stay true.
LEAD_REPORT_INCLUDE_SUPER_ADMINS=false
