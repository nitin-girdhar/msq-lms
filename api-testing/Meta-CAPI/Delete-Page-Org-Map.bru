meta {
  name: Delete Page/Form Org Mapping
  type: http
  seq: 12
}

delete {
  url: {{baseUrl}}/meta/page-org-map/{{mappingId}}?tenant_id={{tenantId}}
  body: none
  auth: none
}

headers {
  Cookie: auth_token={{authToken}}
}

docs {
  Removes a Page/Form -> org mapping. Requires super_admin. Leads from that
  form are logged as "unmapped" and skipped until a new mapping exists.

  A real DELETE, not a soft delete: ext.meta_page_form_org_map carries no
  is_deleted column and no soft_delete_row trigger.

  Regression checks, identical to PATCH:
    * mappingId belonging to ANOTHER tenant -> 404, NOT 204
    * mappingId that does not exist         -> 404
    * caller below super_admin              -> 403
}
