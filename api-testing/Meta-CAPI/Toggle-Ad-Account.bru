meta {
  name: Enable Meta Ad Account
  type: http
  seq: 32
}

patch {
  url: {{baseUrl}}/meta/ad-accounts/{{adAccountId}}
  body: json
  auth: none
}

headers {
  Cookie: auth_token={{authToken}}
}

body:json {
  {
    "is_enabled": true
  }
}

docs {
  adAccountId looks like act_<digits>. Fetch campaigns walks enabled accounts only.
}
