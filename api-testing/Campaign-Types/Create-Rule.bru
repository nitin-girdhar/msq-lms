meta {
  name: Create Campaign Type Rule
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/campaign-types/rules?tenant_id={{tenantId}}
  body: json
  auth: none
}

headers {
  Cookie: auth_token={{authToken}}
}

body:json {
  {
    "match_field": "campaign_name",
    "pattern": "HIR",
    "campaign_type_id": "{{hiringTypeId}}"
  }
}

docs {
  match_field: campaign_name | form_name | adset_name | ad_name. Pattern matches a whole word/phrase,
  case-insensitive. Omit rule_order to append at the end; pass one to insert there (the tail shifts down).
  A type from another tenant is refused by trg_campaign_type_rules_tenant_match.
}
