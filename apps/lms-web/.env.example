# lms-web (Next.js, lms.app.com) — required environment variables
NEXT_PUBLIC_API_URL=http://localhost:4000
API_GATEWAY_INTERNAL_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string-at-least-64-chars
# JWT_PUBLIC_KEY=   # RS256 verification; falls back to JWT_SECRET (HS256) when unset
# JWT_KID=

# Must match identity-service's PASSWORD_MIN_LENGTH — drives the
# password-strength checklist (e.g. admin reset-password modal).
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=12

# SSO: unauthenticated users bounce to NEXT_PUBLIC_AUTH_URL/login; the product
# switcher links to the sibling origins. Leave COOKIE_DOMAIN unset for
# single-host local dev.
COOKIE_SECURE=false
NEXT_PUBLIC_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_LMS_URL=http://localhost:3001
NEXT_PUBLIC_HR_URL=http://localhost:3002
NEXT_PUBLIC_TASK_URL=http://localhost:3003

# RS256 migration switch. While HS256 is accepted, RS256 buys nothing security-wise:
# JWT_SECRET mints equally valid tokens and must exist wherever tokens are verified.
# Cutover: (1) set JWT_PRIVATE_KEY + JWT_KID on identity-service and JWT_PUBLIC_KEY
# everywhere; (2) wait one full token lifetime; (3) set this to false EVERYWHERE;
# (4) delete JWT_SECRET from everything that does not sign.
# Only the exact string 'false' disables HS256. Setting false without an RSA key makes
# identity-service refuse to boot - deliberately, since it would otherwise sign tokens
# that nothing, including itself, could verify.
JWT_ALLOW_HS256=true
